#!/usr/bin/env bash

set -e

REPO_URL="https://github.com/tibi-iorga/tstack.git"
TSTACK_DIR="${TSTACK_DIR:-$HOME/.tstack}"
OLD_DIR="$HOME/.claude/skills/tstack"
CLAUDE_MD="$HOME/.claude/CLAUDE.md"
IMPORT_LINE="@~/.tstack/CLAUDE.md"
OLD_IMPORT_LINE="@~/.claude/skills/tstack/CLAUDE.md"

echo ""
echo "tstack setup"
echo "------------"

# Clone or update the repo at ~/.tstack
if [ -d "$TSTACK_DIR/.git" ]; then
  echo "Updating tstack..."
  git -C "$TSTACK_DIR" pull
else
  # Older versions used ~/.tstack as an update-check cache directory.
  # Move any non-repo directory aside so the clone can proceed.
  if [ -d "$TSTACK_DIR" ]; then
    mv "$TSTACK_DIR" "$TSTACK_DIR.bak-$(date +%s)"
    echo "Moved existing non-repo $TSTACK_DIR aside"
  fi
  echo "Installing tstack to $TSTACK_DIR..."
  git clone "$REPO_URL" "$TSTACK_DIR"
fi

# Copy each skill into a skills directory
install_skills() {
  target="$1"
  count=0
  mkdir -p "$target"
  for skill_dir in "$TSTACK_DIR/skills"/*/; do
    skill_name=$(basename "$skill_dir")
    mkdir -p "$target/$skill_name"
    cp -R "$skill_dir." "$target/$skill_name/"
    count=$((count + 1))
  done
  echo "Installed $count skills to $target"
}

# Canonical cross-tool location (Agent Skills standard, read by Cursor and others)
install_skills "$HOME/.agents/skills"

# Tool-specific locations, only where the tool is present
if [ -d "$HOME/.claude" ]; then
  install_skills "$HOME/.claude/skills"
fi
if [ -d "$HOME/.codex" ]; then
  install_skills "$HOME/.codex/skills"
fi

# Remove only the global imports previously installed by tstack.
if [ -f "$CLAUDE_MD" ]; then
  import_temp=$(mktemp "${CLAUDE_MD}.tstack.XXXXXX")
  imports_removed=0
  first_line=1
  while :; do
    line=""
    has_newline=0
    IFS= read -r line && has_newline=1
    [ "$has_newline" -eq 1 ] || [ -n "$line" ] || break
    if [ "$first_line" -eq 1 ]; then
      first_line=0
      if [[ "$line" == $'\xef\xbb\xbf'* ]]; then
        printf '\xef\xbb\xbf'
        line="${line#$'\xef\xbb\xbf'}"
      fi
    fi
    case "${line%$'\r'}" in
      "$IMPORT_LINE"|"$OLD_IMPORT_LINE")
        imports_removed=1
        continue
        ;;
    esac
    printf '%s' "$line"
    if [ "$has_newline" -eq 1 ]; then
      printf '\n'
    fi
  done < "$CLAUDE_MD" > "$import_temp"
  if [ "$imports_removed" -eq 1 ]; then
    cat "$import_temp" > "$CLAUDE_MD"
    echo "Removed tstack global imports from ~/.claude/CLAUDE.md"
  fi
  rm -f "$import_temp"
fi

echo ""
echo "Done. Restart your agent (Claude Code, Cursor, Codex) to pick up the skills."
echo ""

# Remove the old install location so skills are not registered twice.
# Runs last so a failure here cannot break the install above.
if [ -d "$OLD_DIR" ]; then
  case "$PWD/" in
    "$OLD_DIR"/*)
      echo "Old install detected at ~/.claude/skills/tstack and it is your current directory."
      echo "Remove it manually to avoid duplicate skills: cd ~ && rm -rf ~/.claude/skills/tstack"
      ;;
    *)
      rm -rf "$OLD_DIR" 2>/dev/null && echo "Removed old install at ~/.claude/skills/tstack" || {
        echo "Could not remove old install. Remove it manually: rm -rf ~/.claude/skills/tstack"
      }
      ;;
  esac
fi
